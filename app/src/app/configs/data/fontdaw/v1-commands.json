  },
  "comment_scopes": "Scopes chosen by hand for commands that the 4.7 layout binds and the v2 base file does not (shortcut work order v2, A3a).",
  "fontdaw_keys": {
    "command://pointertools/open-pointer-menu": { "scope": "NOTATION", "sequences": ["Tab"], "why": "Tab over the score opens the Command menu at the pointer (owner, 20 November 2026); next-panel keeps Tab in NAVIGATION, so panels, dialogs and text fields still navigate" }
  },
  "comment_fontdaw_keys": "FontDaw's own keys on top of 4.7, reviewed: command, scope, sequences and why. The generator adds them to both layouts and leaves them out of the comparison with the 4.7 key files. To drop one, delete its entry and regenerate.",
  "additions": {
    "command://app/preferences": "Ctrl+, opens Preferences: the platform convention, added by upstream; 4.7 had no key",
    "command://navigation/escape": "Esc leaves a panel or pop-up in keyboard navigation; v1 handled it without a binding",
    "command://notation/freeze-current-placement": "a command upstream added after 4.7",
    "command://none": "upstream's Shift+Up / Shift+Down catch, so they do nothing in note input, as in 4.7"
  }
}
